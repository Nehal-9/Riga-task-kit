{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-start.py",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/after-edit-validate.py",
        "timeout": 20
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/stop-qa.py",
        "timeout": 15
      }
    ]
  }
}
